# Database connection settings, read by database.py (and the migrate/import scripts).
#
# These are the standard PostgreSQL (libpq) environment variables. If they are not
# set, the code falls back to the same values shown here, which match the local
# Docker container created by ./create_and_run_database.sh.
#
# The values below are throwaway, localhost-only DEVELOPMENT credentials from the
# course scaffold. They are NOT secrets. In any real or shared deployment, override
# every value here with your own settings and never commit a real password.
#
# Usage: copy this file to `.env` and adjust as needed (`.env` is git-ignored).

PGHOST=localhost
PGPORT=9876
PGDATABASE=lego-db
PGUSER=lego
PGPASSWORD=bricks
